# PropertyVoice Environment Variables
# Copy this file to dev.env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Twilio credentials (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_SECRET_KEY=sk-...

# Google Sheets (service account JSON, not file path - paste the entire JSON)
GOOGLE_SHEET_ID=...
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"..."}

# =============================================================================
# OPTIONAL
# =============================================================================

# ElevenLabs TTS (falls back to Twilio Say if not configured)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# Slack notifications (skipped if not configured)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Call flow mode: "conversational" (default) or "dtmf" (legacy menu)
CALL_FLOW_MODE=conversational
